{
  "name": "do_test_chat",
  "description": "测试聊天插件：返回“输入 + do_chat_test + 时间（Unix 毫秒）”，不访问网络、不读写数据库。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "单轮输入；与 messages 二选一。优先使用非空 prompt。"
      },
      "messages": {
        "type": "array",
        "description": "多轮消息；取最后一条非空 user 消息。",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "description": "system / user / assistant"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "role",
            "content"
          ]
        }
      }
    },
    "anyOf": [
      { "required": ["prompt"] },
      { "required": ["messages"] }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer"
      },
      "data": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "输入 + do_chat_test + 时间"
          },
          "input": {
            "type": "string",
            "description": "实际使用的输入"
          },
          "tag": {
            "type": "string",
            "const": "do_chat_test"
          },
          "time": {
            "type": "integer",
            "description": "Unix 毫秒时间戳"
          }
        }
      },
      "msg": {
        "type": "string"
      }
    },
    "required": [
      "code",
      "msg"
    ]
  },
  "transport": {
    "endpoint": "/do_test_chat",
    "ffiSymbol": "chat"
  }
}
